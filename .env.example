# ==================== URBOOTH PUBLIC ENV VARIABLES ====================
# JANGAN simpan service_role key atau API secret di frontend!
# Hanya nilai publik dengan prefix VITE_ yang boleh dipakai di browser.

# 1. Supabase Storage (untuk fitur Unduh via QR & halaman /d/:id)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_ANON_KEY
VITE_SUPABASE_BUCKET=urbooth-results

# 2. Opsional: URL publik website produksi (dipakai untuk link QR)
# Jika dikosongkan, otomatis memakai window.location.origin
VITE_PUBLIC_APP_URL=https://urbooth.vercel.app

# 3. Opsional: Jika ingin upload lewat serverless endpoint kustom
# VITE_UPLOAD_ENDPOINT=/api/upload-result
